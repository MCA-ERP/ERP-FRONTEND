# PROD (live): settings for the website.
# Copy this file to env/.env.prod and fill it in. The real file is never committed.
# Run it with:  npm run dev:prod   or   npm run build:prod then npm run start:prod
# These values are built into the site, so build and start with the same environment.
# Never add SUPABASE_SERVICE_ROLE_KEY here.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The API of the same environment
NEXT_PUBLIC_API_URL=https://api.myclassassist.in/api/v1
NEXT_PUBLIC_BACKEND_URL=https://api.myclassassist.in/health

# Where each portal lives
NEXT_PUBLIC_ADMIN_DASHBOARD_URL=https://erp.myclassassist.in
NEXT_PUBLIC_SCHOOL_DASHBOARD_URL=https://sch.myclassassist.in
NEXT_PUBLIC_APP_DOMAIN=myclassassist.in
# Share the sign-in across subdomains, like .myclassassist.in (leave empty on your own computer)
NEXT_PUBLIC_COOKIE_DOMAIN=.myclassassist.in
