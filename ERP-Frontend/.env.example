# Public values (shipped to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Optional: share the sign-in session across subdomains, e.g. .myclassassist.in
NEXT_PUBLIC_COOKIE_DOMAIN=
NEXT_PUBLIC_APP_DOMAIN=
NEXT_PUBLIC_ADMIN_DASHBOARD_URL=
NEXT_PUBLIC_SCHOOL_DASHBOARD_URL=

# Never put SUPABASE_SERVICE_ROLE_KEY here: the frontend does not use it, and it bypasses all database security.
